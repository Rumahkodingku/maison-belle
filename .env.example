# Public site URL, e.g. https://maisonbelle.example
# Leave empty to defer canonical URLs and use localhost during local builds.
NEXT_PUBLIC_SITE_URL=

# Business WhatsApp number in international digits only, e.g. 6281234567890.
# Leave empty to disable the WhatsApp handoff and show the safe fallback.
NEXT_PUBLIC_WHATSAPP_NUMBER=
